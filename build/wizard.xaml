<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SingAlong Setup" Width="760" Height="510"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Foreground="#F5F1FF" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#292338"/>
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.35"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#D6C7FF"/>
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#15141E"/>
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="CaretBrush" Value="#BBA6FF"/>
      <Setter Property="SelectionBrush" Value="#655386"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="#453C59" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="OptionSurface" Background="#211D31" BorderBrush="#332E44" BorderThickness="1" CornerRadius="9" Padding="12">
              <DockPanel>
                <Border Width="16" Height="16" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#817293" CornerRadius="8">
                  <Ellipse x:Name="Dot" Fill="#BBA6FF" Margin="3" Visibility="Hidden"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="OptionSurface" Property="BorderBrush" Value="#BBA6FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#2B243C"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionSurface" Property="BorderBrush" Value="#D6C7FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#15141E" BorderBrush="#453C59" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#1C1929" CornerRadius="16,0,0,16" Padding="24,34">
        <Grid>
          <StackPanel>
            <Border Width="64" Height="64" Background="#BBA6FF" CornerRadius="17" HorizontalAlignment="Left">
              <Viewbox><Canvas Width="32" Height="32">
                <Line X1="9" X2="9" Y1="14" Y2="18" Stroke="#251C3D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="16" X2="16" Y1="8" Y2="24" Stroke="#251C3D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="23" X2="23" Y1="12" Y2="20" Stroke="#251C3D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Canvas></Viewbox>
            </Border>
            <TextBlock Text="SingAlong" FontSize="25" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <TextBlock x:Name="VersionText" Foreground="#BBA6FF" FontSize="12"/>
            <TextBlock Text="Lyrics for your&#10;next game." Foreground="#BCB3CE" FontSize="14" LineHeight="23" Margin="0,24,0,0"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="Created by Andiilul" FontSize="12" Foreground="#BCB3CE"/>
            <TextBlock Text="2026" FontSize="12" Foreground="#BCB3CE" Margin="0,3,0,10"/>
            <Button x:Name="GitHubButton" Content="GitHub @Andiilul" Padding="0" Background="Transparent" Foreground="#BBA6FF" HorizontalAlignment="Left"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
        <Grid x:Name="DragHeader" Background="Transparent">
          <TextBlock Text="SETUP" Foreground="#817293" FontSize="11" VerticalAlignment="Center" Margin="30,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
            <Button x:Name="MinimizeButton" Width="32" Height="28" Padding="0" Background="Transparent" Margin="0,0,4,0" AutomationProperties.Name="Minimize">
              <Path Data="M 0,0 L 11,0" Stroke="#BCB3CE" StrokeThickness="1.5"/>
            </Button>
            <Button x:Name="CloseButton" Width="32" Height="28" Padding="0" Background="Transparent" AutomationProperties.Name="Close">
              <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#BCB3CE" StrokeThickness="1.5"/>
            </Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="30,14,30,0">
          <StackPanel x:Name="WelcomePage">
            <TextBlock Text="Make room for&#10;your next sing-along." FontSize="28" FontWeight="SemiBold" LineHeight="36"/>
            <TextBlock Text="Keep Spotify lyrics within reach while you play." TextWrapping="Wrap" Foreground="#BCB3CE" FontSize="14" LineHeight="23" Margin="0,20,0,0"/>
            <TextBlock Text="Choose where to install SingAlong, then you are ready to go." TextWrapping="Wrap" Foreground="#BCB3CE" FontSize="13" LineHeight="22" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
            <TextBlock Text="Installation" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <RadioButton x:Name="CurrentUserOption" Content="Only for me" GroupName="InstallScope" IsChecked="True"/>
            <RadioButton x:Name="AllUsersOption" Content="Everyone on this computer" GroupName="InstallScope"/>
            <TextBlock Text="Installation folder" Foreground="#BCB3CE" Margin="0,8,0,8"/>
            <TextBox x:Name="InstallPath" AutomationProperties.Name="Installation folder"/>
            <TextBlock x:Name="InstallHint" Foreground="#BCB3CE" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="#F4A7BB" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="InstallingPage" Visibility="Collapsed">
            <TextBlock Text="Installing SingAlong" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Your lyrics overlay is almost ready." Foreground="#BCB3CE" Margin="0,14,0,0"/>
            <Border Background="#332E44" Height="6" CornerRadius="3" Margin="0,36,0,0" ClipToBounds="True">
              <Border Background="#BBA6FF" Width="110" CornerRadius="3" HorizontalAlignment="Left">
                <Border.RenderTransform><TranslateTransform x:Name="ProgressMotion"/></Border.RenderTransform>
              </Border>
            </Border>
            <TextBlock Text="Please keep this window open." Foreground="#BCB3CE" FontSize="12" Margin="0,20,0,0"/>
          </StackPanel>
          <StackPanel x:Name="FinishPage" Visibility="Collapsed">
            <TextBlock Text="You are ready&#10;to sing along." FontSize="28" FontWeight="SemiBold" LineHeight="36"/>
            <TextBlock Text="SingAlong has been installed successfully." Foreground="#BCB3CE" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <TextBlock Text="Open Spotify Desktop and start a song." Foreground="#BCB3CE" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="30,0">
          <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CancelButton" Content="Cancel" Background="Transparent" Margin="0,0,10,0"/>
            <Button x:Name="NextButton" Content="Get started" Background="#BBA6FF" Foreground="#251C3D" FontWeight="SemiBold" MinWidth="108"/>
          </StackPanel>
        </Grid>
      </Grid>
      <Border x:Name="CancelDialog" Grid.ColumnSpan="2" Background="#BB08070D" CornerRadius="16" Visibility="Collapsed">
        <Border Background="#211D31" BorderBrush="#453C59" BorderThickness="1" CornerRadius="14" Width="350" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Close SingAlong Setup?" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="You can run the installer again whenever you are ready." TextWrapping="Wrap" Foreground="#BCB3CE" LineHeight="21"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
              <Button x:Name="KeepSetupButton" Content="Keep setting up" Margin="0,0,10,0"/>
              <Button x:Name="ExitSetupButton" Content="Close" Background="#BBA6FF" Foreground="#251C3D"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
